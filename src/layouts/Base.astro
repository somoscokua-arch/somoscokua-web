---
import '../styles/global.css';
import LogoSprite from '../components/LogoSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&family=Mr+Dafoe&display=swap" />
  </head>
  <body>
    <LogoSprite />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
