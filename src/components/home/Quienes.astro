---
import t from '../../content/textos.json';
import Logo from '../Logo.astro';
---
<section id="quienes" class="band">
  <div class="wrap about">
    <div class="about-left">
      <h2>{t.quienes.titulo}</h2>
      <p class="lede">{t.quienes.intro}</p>
      <Logo class="big-logo" sizes="(max-width: 820px) 80vw, 330px" alt="Logo de la Fundación Somos Cokua" />
    </div>
    <div class="pillars">
      {t.quienes.pilares.map((p) => (
        <article class="pillar">
          <h3>{p.titulo}</h3>
          <p><strong>{p.destacado}</strong> {p.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>
