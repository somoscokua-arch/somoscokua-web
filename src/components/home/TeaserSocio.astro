---
import t from '../../content/textos.json';
---
<section id="socio" class="band band--teal">
  <div class="wrap teaser">
    <div class="section-head">
      <span class="new new--ink" style="align-self:flex-start">{t.teaserSocio.etiqueta}</span>
      <h2>{t.teaserSocio.titulo}</h2>
      <p class="lede">{t.teaserSocio.texto}</p>
    </div>
    <a class="btn btn--white" href={t.teaserSocio.boton.href}>{t.teaserSocio.boton.texto}</a>
  </div>
</section>
