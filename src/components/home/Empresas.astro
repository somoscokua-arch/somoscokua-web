---
import t from '../../content/textos.json';
import planesEmpresa from '../../content/planes-empresas.json';
const c = t.empresas.calculadora;
const fmt = (n: number) => '$' + Math.round(n).toLocaleString('es-CO');
const ini = planesEmpresa[c.indiceInicial];
const anual = ini.aporteMensual * 12;
const planesDatos = planesEmpresa.map((p) => ({ nombre: p.nombre, monto: p.aporteMensual }));
---
<section id="empresas" class="band band--ink">
  <div class="wrap biz">
    <div class="text">
      <span class="new" style="align-self:flex-start">{t.empresas.etiqueta}</span>
      <h2>{t.empresas.titulo}</h2>
      <p class="lede">{t.empresas.texto}</p>
      <ul class="checks">
        {t.empresas.checks.map((x) => <li>{x}</li>)}
      </ul>
      <div><a class="btn btn--orange" href={t.empresas.boton.href}>{t.empresas.boton.texto}</a></div>
    </div>
    <div class="calc" data-porcentaje={c.porcentaje} data-planes={JSON.stringify(planesDatos)}>
      <label for="aporte">{c.etiqueta} <b id="aporte-label">{fmt(ini.aporteMensual)}</b></label>
      <input id="aporte" type="range" min="0" max={planesEmpresa.length - 1} step="1" value={c.indiceInicial}
        aria-valuetext={`${fmt(ini.aporteMensual)}, ${ini.nombre}`}>
      <p class="calc-plan">{c.etiquetaPlan}: <b id="aporte-plan">{ini.nombre}</b></p>
      <table>
        <tr><td>{c.filaAnual}</td><td id="c-anual">{fmt(anual)}</td></tr>
        <tr><td>{c.filaDescuento}</td><td id="c-desc">{fmt(anual * c.porcentaje)}</td></tr>
        <tr class="total"><td>{c.filaNeto}</td><td id="c-neto">{fmt(anual - anual * c.porcentaje)}</td></tr>
      </table>
      <p class="fine">{c.nota}</p>
      <div><a class="btn btn--white" href={c.boton.href}>{c.boton.texto}</a></div>
    </div>
  </div>
</section>
<script>
  import '../../scripts/calculadora.ts';
</script>
