---
import t from '../../content/textos.json';
import proyectos from '../../content/proyectos.json';
import Photo from '../Photo.astro';
---
<section id="proyectos" class="band" style="padding-top:0">
  <div class="wrap">
    <div class="section-head">
      <h2>{t.proyectos.titulo}</h2>
      <p class="lede">{t.proyectos.texto}</p>
    </div>
    <div class="projects">
      {proyectos.map((p) => (
        <article class="proj"><Photo foto={p.foto} alt={p.alt} posicion={p.enfoque} etiqueta={t.proyectos.fotoEtiqueta} widths={[320, 480, 640, 800]} sizes="(max-width: 480px) 100vw, (max-width: 980px) 50vw, 320px" /><h4>{p.titulo}</h4><p>{p.descripcion}</p></article>
      ))}
    </div>
  </div>
</section>
