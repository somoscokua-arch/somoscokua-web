---
import t from '../../content/textos.json';
import planes from '../../content/planes.json';
import pagos from '../../config/pagos.json';
---
<section class="band--teal dona-plans">
  <div class="wrap">
    <div class="plans">
      {planes.map((p) => {
        const url = (pagos.planes as Record<string, { url: string }>)[p.id]?.url ?? '';
        const clase = p.destacado ? 'btn' : 'btn btn--ink';
        return (
          <article class:list={['plan', { 'plan--feat': p.destacado }]}>
            {p.etiqueta && <span class="tag">{p.etiqueta}</span>}
            <span class="name">{p.nombre}</span>
            <span class="price">{p.precio} <small>{p.periodo}</small></span>
            <ul>{p.beneficios.map((b) => <li>{b}</li>)}</ul>
            {url
              ? <a class={clase} href={url} target="_blank" rel="noopener">{p.boton}</a>
              : <a class={clase} href="/dona" data-plan-sin-enlace>{p.boton}</a>}
          </article>
        );
      })}
    </div>
    <p class="pay-note" id="pay-note" aria-live="polite" data-msg-sin-enlace={t.dona.planSinEnlace}>{t.dona.notaPago}</p>
  </div>
</section>
<script>
  import '../../scripts/planes.ts';
</script>
