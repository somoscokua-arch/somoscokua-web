---
import t from '../../content/textos.json';
import Photo from '../Photo.astro';
---
<section class="band--teal dona-hero">
  <div class="wrap dona-hero__grid">
    <div>
      <p class="eyebrow" style="margin-bottom:14px">{t.dona.etiqueta}</p>
      <h1>{t.dona.titulo}</h1>
      <p class="lede">{t.dona.texto}</p>
    </div>
    <div class="dona-hero__foto">
      <Photo foto={t.dona.foto} alt={t.dona.fotoAlt} posicion={t.dona.fotoEnfoque} widths={[480, 720, 1000, 1400]} sizes="(max-width: 820px) 100vw, 560px" prioridad />
    </div>
  </div>
</section>
